{
  "name": "openexpert",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.21.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:run",
    "test:run": "vitest run && npm run test:run --workspaces --if-present",
    "test:coverage": "vitest run --coverage && npm run test:coverage --workspaces --if-present",
    "openexpert:doctor": "node ./packages/openexpert/bin/openexpert.js doctor",
    "openexpert:serve": "node ./packages/openexpert/bin/openexpert.js serve",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:install": "node scripts/install-desktop.mjs",
    "desktop:uninstall": "node scripts/uninstall-desktop.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "license:check": "node scripts/license-check.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:commits": "node scripts/check-commits.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@ai-sdk/react": "^4.0.146",
    "@hookform/resolvers": "^5.2.2",
    "@openexpert/openexpert": "*",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
