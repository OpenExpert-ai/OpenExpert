{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenExpert",
  "mainBinaryName": "openexpert-desktop",
  "version": "0.5.0",
  "identifier": "ai.openexpert.desktop",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenExpert",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
