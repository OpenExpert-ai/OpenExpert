# ---------------------------------------------------------------------------
# OpenExpert — environment variables (local edition)
# Copy this file to .env and fill in what you need. `.env` is gitignored.
# Most people only need a model provider (see OPENEXPERT_MODEL_PROVIDER).
# ---------------------------------------------------------------------------

# --- AI --------------------------------------------------------------------
# Provider for the chat model. One of:
#   ollama              — local models, no keys (recommended).
#   google              — Gemini via GOOGLE_API_KEY (free key from AI Studio).
#   openai-compatible   — your own endpoint with OPENEXPERT_MODEL_KEY.
OPENEXPERT_MODEL_PROVIDER="ollama"

# Identifier of the model as known by the chosen provider.
OPENEXPERT_MODEL_ID="llama3.1"

# Required when OPENEXPERT_MODEL_PROVIDER=google.
GOOGLE_API_KEY=""

# Required when OPENEXPERT_MODEL_PROVIDER=openai-compatible.
# OPENEXPERT_MODEL_KEY=""
# OPENEXPERT_BASE_URL="https://your-endpoint/v1"

# Ollama endpoint (default local).
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# --- Google Drive (optional) ------------------------------------------------
# Create an OAuth client in Google Cloud with the Drive API enabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. Defaults to <app origin>/auth/google/callback.
# GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
# Secret used to sign the OAuth `state`. If unset, one is generated and kept
# locally in OPENEXPERT_DATA_DIR.
# GOOGLE_OAUTH_STATE_SECRET=""

# --- Local data -------------------------------------------------------------
# Directory for the SQLite database and credentials (default ~/.openexpert/).
OPENEXPERT_DATA_DIR="~/.openexpert"

# --- Misc -------------------------------------------------------------------
# Public origin of the app (used to build the Drive redirect URI).
# PUBLIC_APP_URL="http://localhost:3000"
