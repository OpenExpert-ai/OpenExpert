# ---------------------------------------------------------------------------
# OpenExpert — environment variables (local edition)
# Copy this file to .env and fill in what you need. `.env` is gitignored.
# Most people only need a model provider (see OPENEXPERT_MODEL_PROVIDER).
# ---------------------------------------------------------------------------

# --- AI --------------------------------------------------------------------
# Provider for the chat model. One of:
#   ollama              — local models, no keys (recommended).
#   google              — Gemini via GOOGLE_API_KEY (free key from AI Studio).
#   anthropic           — Claude via ANTHROPIC_API_KEY.
#   openai-compatible   — your own endpoint with OPENEXPERT_MODEL_KEY.
#   opencode-go         — OpenCode Go via OPENCODE_GO_API_KEY.
OPENEXPERT_MODEL_PROVIDER="ollama"

# Identifier of the model as known by the chosen provider.
OPENEXPERT_MODEL_ID="llama3.1"

# One key per provider: each one goes in its own variable, and saving a key
# never overwrites another provider's. Only the key of the provider you use.
# GOOGLE_API_KEY=""                           # aistudio.google.com/apikey
# ANTHROPIC_API_KEY=""                        # console.anthropic.com/settings/keys
# OPENCODE_GO_API_KEY=""

# Only for the generic `openai-compatible` provider, which is the only one whose
# endpoint you provide (the others bring their own).
# OPENEXPERT_MODEL_KEY=""
# OPENEXPERT_BASE_URL="https://your-endpoint/v1"

# Ollama endpoint. The native root and the OpenAI-compatible `/v1` URL are
# both accepted; OpenExpert normalises them.
# OLLAMA_BASE_URL="http://localhost:11434"

# --- Google Drive (optional) ------------------------------------------------
# Drive uses the non-sensitive `drive.file` scope (per-file access, localhost
# redirect). See docs/en/06-integrations.md.
#
# The client_id is public and may also live in openexpert.json.
# OPENEXPERT_GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Required for the in-browser Google Drive selector (Picker API key). Safe to be
# client-side; restrict it by HTTP referrer (localhost) and by API (Picker only).
GOOGLE_PICKER_API_KEY=""
# Optional. Defaults to <app origin>/auth/google/callback.
# GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
# Secret used to sign the OAuth `state`. If unset, one is generated and kept
# locally in OPENEXPERT_DATA_DIR.
# GOOGLE_OAUTH_STATE_SECRET=""
# URL of the privacy policy shown to the user before activating Drive.
# Defaults to the policy shipped in the repo; set it to a publicly
# accessible URL if you host one.
# OPENEXPERT_PRIVACY_URL=""

# --- Notion (optional) ------------------------------------------------------
# Notion connects with a public OAuth 2.0 connection. The non-secret client ID
# may also live in openexpert.json as `notionClientId`; the secret stays in the
# environment or ~/.openexpert/secrets.json.
# OPENEXPERT_NOTION_CLIENT_ID=""
# NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
# Optional. Defaults to <app origin>/auth/notion/callback.
# NOTION_REDIRECT_URI="http://localhost:3000/auth/notion/callback"
# Secret used to sign the Notion OAuth `state`. If unset, one is generated and
# kept locally in OPENEXPERT_DATA_DIR.
# NOTION_OAUTH_STATE_SECRET=""

# --- Local data -------------------------------------------------------------
# Directory for the SQLite database and credentials (default ~/.openexpert/).
OPENEXPERT_DATA_DIR="~/.openexpert"

# --- Misc -------------------------------------------------------------------
# Public origin of the app (used to build the Drive redirect URI).
# PUBLIC_APP_URL="http://localhost:3000"

# Google Picker — Cloud project number. Find it in Google Cloud Console →
# Dashboard → "Project number". It is a PUBLIC value.
# GOOGLE_PICKER_APP_ID=""

# --- Server -----------------------------------------------------------------
# Interface the local server binds. Loopback by default: the dashboard has no
# authentication, so 0.0.0.0 exposes it to whoever shares your network.
# `HOST` is accepted as an alias.
# OPENEXPERT_HOST="127.0.0.1"
# PORT="3000"
# debug | info | warn | error (default: debug in development, info otherwise).
# OPENEXPERT_LOG_LEVEL="info"
