# ---------------------------------------------------------------------------
# OpenExpert — environment variables
# Copy this file to .env and fill in the values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase (required for the cloud edition) -----------------------------
# Project Settings -> API. The "publishable key" goes to the browser; the
# "secret key" stays on the server only.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# VITE_* values are the ones the browser bundle can read. They must match
# the ones above; Vite injects them from .env into the build and dev server.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- AI --------------------------------------------------------------------
# Provider for the chat model. One of:
#   google               — Gemini via GOOGLE_API_KEY (default for cloud).
#   ollama               — local model, no data leaves your machine.
#   openai-compatible    — your own endpoint with OPENEXPERT_MODEL_KEY.
#   openexpert           — the OpenExpert model gateway (account token).
OPENEXPERT_MODEL_PROVIDER="google"

# Identifier of the model as known by the chosen provider.
OPENEXPERT_MODEL_ID="gemini-2.5-flash"

# Google AI Studio — required when OPENEXPERT_MODEL_PROVIDER=google.
GOOGLE_API_KEY=""

# Required when OPENEXPERT_MODEL_PROVIDER=openai-compatible.
# OPENEXPERT_MODEL_KEY=""
# OPENEXPERT_BASE_URL="https://your-endpoint/v1"

# Required when OPENEXPERT_MODEL_PROVIDER=openexpert (the hosted gateway).
# OPENEXPERT_GATEWAY_URL="https://gateway.openexpert.example/v1"
# OPENEXPERT_API_KEY=""
# OPENEXPERT_GATEWAY_ACCOUNT=""

# Required when OPENEXPERT_MODEL_PROVIDER=ollama.
# OLLAMA_BASE_URL="http://localhost:11434"

# --- Google OAuth / Drive --------------------------------------------------
# Same OAuth client as login. See README -> "Google Cloud".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional. If unset, derived as <app origin>/auth/google/callback and must
# still be registered in Google Cloud.
# GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Secret used to sign the OAuth `state` parameter of the Drive flow.
# If unset, SUPABASE_SERVICE_ROLE_KEY is used. Recommended in production.
# GOOGLE_OAUTH_STATE_SECRET=""

# --- Access ----------------------------------------------------------------
# Owner account email (documentation only). The real gate is the
# `handle_new_user` trigger, which reads the Postgres setting
# `app.owner_email`:
#   ALTER DATABASE postgres SET app.owner_email = 'owner@example.com';
ALLOWED_EMAIL="owner@example.com"

# --- OpenCore / local mode ------------------------------------------------
# local  — on your machine, single owner, no login. (OpenCore edition.)
# cloud  — multi-user, hosted, default behaviour.
OPENEXPERT_MODE="cloud"

# Local data directory (local mode only).
OPENEXPERT_DATA_DIR="~/.openexpert"

# --- Database (for migrations only — not used by the app) ------------------
# Direct connection (IPv6) or the pooler in session mode (IPv4):
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=""

# --- Misc ------------------------------------------------------------------
# Public origin of the app. Useful in production; derived from the request in dev.
PUBLIC_APP_URL=""